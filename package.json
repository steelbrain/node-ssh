{
  "name": "node-ssh",
  "version": "13.2.1",
  "description": "SSH2 with Promises",
  "zshy": {
    "noEdit": true,
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "lint": "(tsc -p . --noEmit) && (tsc -p test) && (oxlint) && (oxfmt --check .)",
    "lint:types": "attw --pack .",
    "prepare": "yarn build",
    "build": "zshy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steelbrain/node-ssh.git"
  },
  "keywords": [
    "ssh",
    "ssh2",
    "sftp"
  ],
  "author": "steelbrain",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/steelbrain/node-ssh/issues"
  },
  "files": [
    "lib/*"
  ],
  "homepage": "https://node-ssh.com",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "22",
    "@types/shell-escape": "^0.2.3",
    "@types/ssh2": "^1.15.6",
    "node-pty": "^1.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "ssh2": "^1.17.0",
    "ssh2-streams": "^0.4.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zshy": "^0.8.1"
  },
  "dependencies": {
    "sb-promise-queue": "^2.1.1",
    "sb-scandir": "^3.1.1",
    "shell-escape": "^0.2.0",
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@types/ssh2": "^1.11.2"
  },
  "peerDependenciesMeta": {
    "@types/ssh2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
