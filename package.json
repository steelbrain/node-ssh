{
  "name": "node-ssh",
  "version": "13.2.1",
  "description": "SSH2 with Promises",
  "zshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "scripts": {
    "test": "ava",
    "lint": "(tsc -p . --noEmit) && (oxlint) && (oxfmt --check src/*.ts)",
    "prepare": "yarn build",
    "build": "zshy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steelbrain/node-ssh.git"
  },
  "keywords": [
    "ssh",
    "ssh2",
    "sftp"
  ],
  "author": "steelbrain",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/steelbrain/node-ssh/issues"
  },
  "files": [
    "lib/*"
  ],
  "homepage": "https://node-ssh.com",
  "devDependencies": {
    "@types/node": "24",
    "@types/shell-escape": "^0.2.3",
    "@types/ssh2": "^1.15.6",
    "ava": "^8.4.0",
    "node-pty": "^1.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "ssh2": "^1.17.0",
    "ssh2-streams": "^0.4.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zshy": "^0.8.1"
  },
  "dependencies": {
    "is-stream": "^2.0.1",
    "make-dir": "^4.0.0",
    "sb-promise-queue": "^2.1.1",
    "sb-scandir": "^3.1.1",
    "shell-escape": "^0.2.0",
    "ssh2": "^1.17.0"
  },
  "ava": {
    "files": [
      "test/*-test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register/transpile-only"
    ]
  },
  "engines": {
    "node": ">= 10"
  }
}
